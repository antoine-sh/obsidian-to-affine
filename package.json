{
	"name": "obsidian-to-affine",
	"version": "0.0.0",
	"description": "Convert an Obsidian vault into files AFFiNE can import",
	"type": "module",
	"bin": {
		"obsidian-to-affine": "dist/cli/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/mdast": "^4.0.4",
		"@types/node": "^22.20.5",
		"@types/unist": "^3.0.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1",
	"dependencies": {
		"fflate": "^0.8.3",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"yaml": "^2.9.1"
	}
}
