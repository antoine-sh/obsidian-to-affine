{
	"name": "obsidian-to-affine",
	"version": "0.0.0",
	"description": "Convert an Obsidian vault into files AFFiNE can import",
	"type": "module",
	"bin": {
		"obsidian-to-affine": "dist/cli/index.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^22.20.5",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.16.1"
}
